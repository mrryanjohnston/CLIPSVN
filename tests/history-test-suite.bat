; ======================================================================
; History: log, blame, diff, and diff-summarize.
; ======================================================================

(println crlf "history-test-suite")

(defglobal ?*hist-repos* = (make-repos "history"))

(defglobal ?*hist-url* = (repos-url "history"))

(defglobal ?*hist-wc* = (make-wc "history" "history-wc"))

(deffunction history-test-suite ()
  (svn-client-set-auth ?*ctx* "ada")
  (commit-file ?*hist-wc* "notes.txt" (str-cat "first draft" ?*nl*) "start the notes")
  (svn-client-set-auth ?*ctx* "grace")
  (commit-file ?*hist-wc* "notes.txt" (str-cat "first draft" ?*nl* "second thoughts" ?*nl*) "revise the notes")
  (commit-file ?*hist-wc* "README" (str-cat "read me" ?*nl*) "add a readme")
  (svn-client-set-auth ?*ctx* "tester")

  ; a log that says nothing about the empty repository
  (bind ?empty (make-repos "history-empty"))
  (bind ?log (svn-client-log ?*ctx* (repos-url "history-empty")))
  (expect "the log of an empty repository is empty: revision 0 is left out" 0 (svn-records-count ?log))
  (svn-records-free ?log)
  (bind ?log (svn-client-log ?*ctx* (repos-url "history-empty") 0))
  (expect "even when asked for" 0 (svn-records-count ?log))
  (svn-records-free ?log)
  (svn-repos-revprop-set ?empty 0 "svn:log" "the beginning")
  (bind ?log (svn-client-log ?*ctx* (repos-url "history-empty") 0))
  (expect "unless it has a message" 1 (svn-records-count ?log))
  (expect "which is the message" "the beginning" (svn-record-field ?log 0 message))
  (expect "of a revision with no author" nil (svn-record-field ?log 0 author))
  (svn-records-free ?log)
  (svn-repos-free ?empty)

  (bind ?log (svn-client-log ?*ctx* ?*hist-url*))
  (expect "svn-client-log answers every revision, newest first" 3 (svn-records-count ?log))
  (expect "of kind log" log (svn-records-kind ?log))
  (expect "with the revision" 3 (svn-record-field ?log 0 revision))
  (expect "the author" "grace" (svn-record-field ?log 0 author))
  (expect-true "the date" (stringp (svn-record-field ?log 0 date)))
  (expect-true "the time" (integerp (svn-record-field ?log 0 time)))
  (expect "the message" "add a readme" (svn-record-field ?log 0 message))
  (expect "no children" FALSE (svn-record-field ?log 0 has-children))
  (expect "and the count of changed paths" 1 (svn-record-field ?log 0 changed-path-count))
  (expect "the oldest is last" 1 (svn-record-field ?log 2 revision))
  (bind ?changes (svn-log-changed-paths ?log))
  (expect "svn-log-changed-paths is of kind changed-path" changed-path (svn-records-kind ?changes))
  (expect "with one record for each path of each revision" 3 (svn-records-count ?changes))
  (expect "the revision" 3 (svn-record-field ?changes 0 revision))
  (expect "the action" A (svn-record-field ?changes 0 action))
  (expect "the path" "/README" (svn-record-field ?changes 0 path))
  (expect "the kind" svn_node_file (svn-record-field ?changes 0 kind))
  (expect "and a modification says M" M (svn-record-field ?changes 1 action))
  (expect "with text-modified" svn_tristate_true (svn-record-field ?changes 1 text-modified))
  (bind ?r (svn-records-free ?changes))
  (expect "the changed paths cannot be freed on their own" FALSE ?r)
  (svn-records-free ?log)
  (bind ?r (svn-records-count ?changes))
  (expect "and go with the log" FALSE ?r)

  (bind ?log (svn-client-log ?*ctx* ?*hist-url* 1 2))
  (expect "a range from 1 to 2 is oldest first" (create$ 1 2)
          (create$ (svn-record-field ?log 0 revision) (svn-record-field ?log 1 revision)))
  (svn-records-free ?log)
  (bind ?log (svn-client-log ?*ctx* ?*hist-url* HEAD 1 1))
  (expect "a limit stops after that many" 1 (svn-records-count ?log))
  (svn-records-free ?log)
  (bind ?log (svn-client-log ?*ctx* ?*hist-url* 2))
  (expect "a start alone is that one revision" 1 (svn-records-count ?log))
  (expect "which is 2" 2 (svn-record-field ?log 0 revision))
  (svn-records-free ?log)
  (bind ?log (svn-client-log ?*ctx* (str-cat ?*hist-wc* "/README")))
  (expect "the log of a working copy file has its revisions" 1 (svn-records-count ?log))
  (expect "which is 3" 3 (svn-record-field ?log 0 revision))
  (svn-records-free ?log)
  (bind ?log (svn-client-log ?*ctx* ?*hist-url* HEAD 1 0 FALSE))
  (expect "without discover-changed-paths, the count is 0" 0 (svn-record-field ?log 0 changed-path-count))
  (bind ?changes (svn-log-changed-paths ?log))
  (expect "and the list is empty" 0 (svn-records-count ?changes))
  (svn-records-free ?log)
  (bind ?r (svn-client-log ?*ctx* ?*hist-url* 9 1))
  (expect "a revision that is not there is a refusal" FALSE ?r)

  ; a copy shows where it came from
  (svn-client-copy ?*ctx* (str-cat ?*hist-url* "/notes.txt") (str-cat ?*hist-url* "/copy.txt") nil FALSE FALSE "copy the notes")
  (bind ?log (svn-client-log ?*ctx* ?*hist-url* 4 4))
  (bind ?changes (svn-log-changed-paths ?log))
  (expect "a copied path knows its source" "/notes.txt" (svn-record-field ?changes 0 copyfrom-path))
  (expect "and the revision it was copied at" 3 (svn-record-field ?changes 0 copyfrom-rev))
  (svn-records-free ?log)

  ; blame
  (bind ?blame (svn-client-blame ?*ctx* (str-cat ?*hist-wc* "/notes.txt")))
  (expect "svn-client-blame has one record for each line" 2 (svn-records-count ?blame))
  (expect "of kind blame" blame (svn-records-kind ?blame))
  (expect "lines are counted from 1" 1 (svn-record-field ?blame 0 line-number))
  (expect "the first line is from revision 1" 1 (svn-record-field ?blame 0 revision))
  (expect "by ada" "ada" (svn-record-field ?blame 0 author))
  (expect "the second from revision 2" 2 (svn-record-field ?blame 1 revision))
  (expect "by grace" "grace" (svn-record-field ?blame 1 author))
  (expect "with the text of the line" "second thoughts" (svn-record-field ?blame 1 line))
  (expect "not a local change" FALSE (svn-record-field ?blame 1 local-change))
  (svn-records-free ?blame)
  (bind ?blame (svn-client-blame ?*ctx* (str-cat ?*hist-url* "/notes.txt") 1 1))
  (expect "blame up to revision 1 is that revision" 1 (svn-records-count ?blame))
  (svn-records-free ?blame)

  ; diff
  (bind ?diff (svn-client-diff ?*ctx* ?*hist-url* 1 ?*hist-url* 2))
  (expect-true "svn-client-diff between two revisions is a unified diff" (str-index "+second thoughts" ?diff))
  (expect-true "with the header" (str-index "Index: notes.txt" ?diff))
  (write-file (str-cat ?*hist-wc* "/notes.txt") (str-cat "first draft" ?*nl* "third thoughts" ?*nl*))
  (bind ?diff (svn-client-diff ?*ctx* ?*hist-wc* BASE ?*hist-wc* WORKING))
  (expect-true "and of a working copy against its base" (str-index "-second thoughts" ?diff))
  (expect-true "in both directions" (str-index "+third thoughts" ?diff))
  (bind ?diff (svn-client-diff ?*ctx* ?*hist-wc* BASE ?*hist-wc* WORKING infinity FALSE TRUE))
  (expect-true "and in the git format when asked" (str-index "diff --git" ?diff))
  (bind ?summary (svn-client-diff-summarize ?*ctx* ?*hist-url* 1 ?*hist-url* 3))
  (expect "svn-client-diff-summarize has one record for each path" 2 (svn-records-count ?summary))
  (expect "of kind diff-summary" diff-summary (svn-records-kind ?summary))
  (expect "README was added" svn_client_diff_summarize_kind_added (svn-record-field ?summary 0 summarize-kind))
  (expect "at that path" "README" (svn-record-field ?summary 0 path))
  (expect "notes.txt was modified" svn_client_diff_summarize_kind_modified (svn-record-field ?summary 1 summarize-kind))
  (expect "its properties were not" FALSE (svn-record-field ?summary 1 prop-changed))
  (expect "and it is a file" svn_node_file (svn-record-field ?summary 1 node-kind))
  (svn-records-free ?summary)
  (svn-client-revert ?*ctx* ?*hist-wc* infinity)

  (svn-repos-free ?*hist-repos*))

(history-test-suite)
