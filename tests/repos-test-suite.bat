; ======================================================================
; Repositories: what svnadmin does. A repository is made and read directly,
; without a working copy.
; ======================================================================

(println crlf "repos-test-suite")

(defglobal ?*repos* = (make-repos "repos"))

(deffunction repos-test-suite ()
  (expect-true "svn-repos-create answers a handle" (handlep ?*repos*))
  (expect "a new repository is at revision 0" 0 (svn-repos-youngest-rev ?*repos*))
  (expect "and is fsfs" "fsfs" (svn-repos-fs-type ?*repos*))
  (expect-true "svn-repos-path is absolute" (svn-dirent-is-absolute (svn-repos-path ?*repos*)))
  (expect "and ends with the name" "repos" (svn-dirent-basename (svn-repos-path ?*repos*)))
  (expect "svn-repos-file-url is the file:// URL of that path"
          (svn-file-url-from-dirent "tests/tmp/repos") (svn-repos-file-url ?*repos*))
  (expect "svn-repos-hook-dir is under it" "hooks" (svn-dirent-basename (svn-repos-hook-dir ?*repos*)))
  (expect "svn-repos-conf-dir too" "conf" (svn-dirent-basename (svn-repos-conf-dir ?*repos*)))
  (expect "svn-repos-uuid is 36 characters" 36 (str-length (svn-repos-uuid ?*repos*)))
  (expect "svn-repos-set-uuid sets one" TRUE (svn-repos-set-uuid ?*repos* "12345678-1234-1234-1234-123456789abc"))
  (expect "and svn-repos-uuid reads it" "12345678-1234-1234-1234-123456789abc" (svn-repos-uuid ?*repos*))
  (expect "svn-repos-set-uuid with nil makes a new one" TRUE (svn-repos-set-uuid ?*repos*))
  (expect-true "which is different" (neq "12345678-1234-1234-1234-123456789abc" (svn-repos-uuid ?*repos*)))

  (expect "the root of revision 0 is a directory" svn_node_dir (svn-repos-check-path ?*repos* "/"))
  (expect "and nil is the root too" svn_node_dir (svn-repos-check-path ?*repos* nil))
  (expect "and a path that is not there is none" svn_node_none (svn-repos-check-path ?*repos* "trunk"))
  (bind ?entries (svn-repos-dir-entries ?*repos* "/"))
  (expect "svn-repos-dir-entries of an empty root is empty" 0 (svn-records-count ?entries))
  (expect "and is a list of dirent records" dirent (svn-records-kind ?entries))
  (svn-records-free ?entries)

  ; revision properties, straight into the filesystem: no hook is consulted
  (expect-true "revision 0 has a date" (stringp (svn-repos-revprop-get ?*repos* 0 "svn:date")))
  (expect "and no author" nil (svn-repos-revprop-get ?*repos* 0 "svn:author"))
  (expect "svn-repos-revprop-set sets one" TRUE (svn-repos-revprop-set ?*repos* 0 "custom:note" "hello"))
  (expect "and svn-repos-revprop-get reads it" "hello" (svn-repos-revprop-get ?*repos* 0 "custom:note"))
  (bind ?props (svn-repos-revprop-list ?*repos* 0))
  (expect "svn-repos-revprop-list has both" 2 (svn-records-count ?props))
  (expect "in name order" "custom:note" (svn-record-field ?props 0 name))
  (expect "with the value" "hello" (svn-record-field ?props 0 value))
  (expect "as revprop records" revprop (svn-records-kind ?props))
  (svn-records-free ?props)
  (expect "svn-repos-revprop-set with nil deletes" TRUE (svn-repos-revprop-set ?*repos* 0 "custom:note" nil))
  (expect "and it is gone" nil (svn-repos-revprop-get ?*repos* 0 "custom:note"))
  (bind ?r (svn-repos-revprop-get ?*repos* 9 "svn:date"))
  (expect "a revision that is not there is a refusal" FALSE ?r)

  ; a second filesystem type
  (system "rm -rf tests/tmp/repos-fsx")
  (bind ?fsx (svn-repos-create "tests/tmp/repos-fsx" "fsx"))
  (expect-true "svn-repos-create makes an fsx repository" (handlep ?fsx))
  (expect "which says so" "fsx" (svn-repos-fs-type ?fsx))
  (svn-repos-free ?fsx)
  (bind ?r (svn-repos-create "tests/tmp/repos-fsx"))
  (expect "and a repository where one is already is a refusal" FALSE ?r)

  ; contents come from a working copy; the repository reads them back

  (bind ?wc (make-wc "repos" "repos-wc"))
  (expect "the first commit is revision 1" 1 (commit-file ?wc "a.txt" (str-cat "one" ?*nl*) "add a"))
  (expect "the second is 2" 2 (commit-file ?wc "b.txt" (str-cat "two" ?*nl*) "add b"))
  (expect "and the repository sees them" 2 (svn-repos-youngest-rev ?*repos*))
  (expect "svn-repos-check-path finds a file" svn_node_file (svn-repos-check-path ?*repos* "a.txt"))
  (expect "in revision 1" svn_node_file (svn-repos-check-path ?*repos* "/a.txt" 1))
  (expect "but b.txt is not there yet" svn_node_none (svn-repos-check-path ?*repos* "b.txt" 1))
  (expect "svn-repos-file-contents reads a file" (str-cat "two" ?*nl*) (svn-repos-file-contents ?*repos* "b.txt"))
  (bind ?entries (svn-repos-dir-entries ?*repos* "/"))
  (expect "svn-repos-dir-entries lists both" 2 (svn-records-count ?entries))
  (expect "in name order" "a.txt" (svn-record-field ?entries 0 path))
  (expect "with the kind" svn_node_file (svn-record-field ?entries 0 kind))
  (expect "the size" 4 (svn-record-field ?entries 0 size))
  (expect "the revision it was made in" 1 (svn-record-field ?entries 0 created-rev))
  (expect "and its author" "tester" (svn-record-field ?entries 0 author))
  (expect "and the path in the filesystem" "/b.txt" (svn-record-field ?entries 1 abs-path))
  (svn-records-free ?entries)
  (bind ?props (svn-repos-node-proplist ?*repos* "a.txt"))
  (expect "svn-repos-node-proplist of a plain file is empty" 0 (svn-records-count ?props))
  (svn-records-free ?props)

  ; the log, from the repository
  (bind ?log (svn-repos-get-logs ?*repos* "/"))
  (expect "svn-repos-get-logs answers every revision, newest first" 2 (svn-records-count ?log))
  (expect "with the revision" 2 (svn-record-field ?log 0 revision))
  (expect "the author" "tester" (svn-record-field ?log 0 author))
  (expect "the message" "add b" (svn-record-field ?log 0 message))
  (expect "and the number of changed paths" 1 (svn-record-field ?log 0 changed-path-count))
  (bind ?changes (svn-log-changed-paths ?log))
  (expect "svn-log-changed-paths has one for each revision" 2 (svn-records-count ?changes))
  (expect "with the revision" 2 (svn-record-field ?changes 0 revision))
  (expect "the action" A (svn-record-field ?changes 0 action))
  (expect "the path" "/b.txt" (svn-record-field ?changes 0 path))
  (expect "and the kind" svn_node_file (svn-record-field ?changes 0 kind))
  (svn-records-free ?log)
  (bind ?log (svn-repos-get-logs ?*repos* nil 1 1))
  (expect "a range of one revision" 1 (svn-records-count ?log))
  (expect "is that revision" 1 (svn-record-field ?log 0 revision))
  (svn-records-free ?log)
  (bind ?log (svn-repos-get-logs ?*repos* "/" nil 1 1))
  (expect "and a limit stops after that many" 1 (svn-records-count ?log))
  (svn-records-free ?log)
  (bind ?log (svn-repos-get-logs ?*repos* "/a.txt"))
  (expect "a path restricts the log to the revisions that touched it" 1 (svn-records-count ?log))
  (svn-records-free ?log)

  ; maintenance
  (expect "svn-repos-verify passes a good repository" TRUE (svn-repos-verify ?*repos*))
  (expect "and a range of it" TRUE (svn-repos-verify ?*repos* 1 2))
  (expect "svn-repos-pack packs" TRUE (svn-repos-pack ?*repos*))
  (system "rm -rf tests/tmp/repos-copy")
  (expect "svn-repos-hotcopy copies" TRUE (svn-repos-hotcopy "tests/tmp/repos" "tests/tmp/repos-copy"))
  (bind ?copy (svn-repos-open "tests/tmp/repos-copy"))
  (expect-true "and svn-repos-open opens the copy" (handlep ?copy))
  (expect "at the same revision" 2 (svn-repos-youngest-rev ?copy))
  (expect "with the same uuid" (svn-repos-uuid ?*repos*) (svn-repos-uuid ?copy))
  (svn-repos-free ?copy)
  (expect "svn-repos-recover recovers" TRUE (svn-repos-recover "tests/tmp/repos-copy"))
  (expect "svn-repos-delete deletes" TRUE (svn-repos-delete "tests/tmp/repos-copy"))
  (bind ?r (svn-repos-open "tests/tmp/repos-copy"))
  (expect "so it cannot be opened" FALSE ?r)

  ; dump and load
  (bind ?dump (svn-repos-dump ?*repos* nil))
  (expect-true "svn-repos-dump with no file answers the dump" (eq (str-index "SVN-fs-dump-format-version" ?dump) 1))
  (expect-true "which has both revisions" (str-index "Revision-number: 2" ?dump))
  (expect "svn-repos-dump to a file" TRUE (svn-repos-dump ?*repos* "tests/tmp/repos.dump"))
  (expect-true "writes it" (read-line-of "tests/tmp/repos.dump"))
  (bind ?loaded (make-repos "repos-loaded"))
  (expect "svn-repos-load loads it" TRUE (svn-repos-load ?loaded "tests/tmp/repos.dump"))
  (expect "to the same revision" 2 (svn-repos-youngest-rev ?loaded))
  (expect "with the same content" (str-cat "one" ?*nl*) (svn-repos-file-contents ?loaded "a.txt"))
  (svn-repos-free ?loaded)
  (bind ?under (make-repos "repos-under"))
  (svn-client-mkdir ?*ctx* (str-cat (repos-url "repos-under") "/old") FALSE "make old")
  (expect "svn-repos-load can put it under a directory that exists" TRUE (svn-repos-load ?under "tests/tmp/repos.dump" "old"))
  (expect "so the file is there" svn_node_file (svn-repos-check-path ?under "old/a.txt"))
  (svn-repos-free ?under)
  (bind ?r (svn-repos-load ?*repos* "tests/tmp/no-such.dump"))
  (expect "a dump that is not there is a refusal" FALSE ?r)

  (svn-repos-free ?*repos*))

(repos-test-suite)
